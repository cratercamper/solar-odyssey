{
  "name": "solar-odyssey",
  "version": "1.0.0",
  "description": "太陽系を宇宙船で旅する教育用3Dウェブアプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "textures": "node scripts/fetch-textures.mjs",
    "stars": "node scripts/build-stars.mjs",
    "smoke": "node tools/smoke/smoke.mjs",
    "test": "vitest run",
    "perf": "node tools/perf/measure.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.7.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "meshoptimizer": "^0.22.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
