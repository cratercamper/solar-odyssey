  "js": "__sv.landing.site('conamara'); return 'ok'",
  "wait": "__sv.landing.state.getState().phase === 'surface'",
  "timeout": 60,
  "sleep": 2
 },
 {
  "name": "e4-race",
  "js": "__sv.rally.start(); return __sv.rally.state.getState().phase",
