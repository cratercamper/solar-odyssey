[
  {"name": "01-home", "sleep": 3},
  {"name": "02-settings", "js": "document.querySelector('details.nav-settings').open = true; return 'open'"},
  {"name": "03-stamps", "js": "document.querySelector('details.nav-settings').open = false; (await import('/src/state/stamps.ts')).openStamps(); return 'ok'"},
  {"name": "04-rocks", "js": "(await import('/src/state/stamps.ts')).closeStamps(); (await import('/src/state/rover.ts')).useSampleLog.setState({ log: { mars: ['mudstone'], phobos: ['regolith-rock'], deimos: ['regolith-rock'], europa: ['ice'] } }); (await import('/src/state/rockBook.ts')).openRocks(); return 'ok'"},
  {"name": "05-rock-found", "js": "(await import('/src/state/rockBook.ts')).useRockBook.setState({ sel: 'phobos:regolith-rock' }); return 'ok'"},
  {"name": "06-rock-unfound", "js": "(await import('/src/state/rockBook.ts')).useRockBook.setState({ sel: 'mars:basalt' }); return 'ok'"},
  {"name": "07-rock-unfound-group", "js": "(await import('/src/state/rockBook.ts')).useRockBook.setState({ sel: 'europa:salt' }); return 'ok'"},
  {"name": "08-quiz", "js": "(await import('/src/state/rockBook.ts')).closeRocks(); (await import('/src/state/quiz.ts')).startQuiz(); return 'ok'"},
  {"name": "09-quiz-answered", "js": "const q = await import('/src/state/quiz.ts'); q.pickAnswer(0); return 'ok'"},
  {"name": "10-quiz-end", "js": "const q = await import('/src/state/quiz.ts'); for (let i = 0; i < 12 && !q.useQuiz.getState().finished; i++) { if (q.useQuiz.getState().picked === null) q.pickAnswer(1); q.nextQuestion() } return q.useQuiz.getState().finished"},
  {"name": "11-chapters", "js": "(await import('/src/state/quiz.ts')).closeQuiz(); (await import('/src/state/mission.ts')).openMissions(); return __sv.mission.getState().phase"},
  {"name": "12-chapter-list", "js": "(await import('/src/state/mission.ts')).openChapter(0); return __sv.mission.getState().phase"},
  {"name": "13-briefing", "js": "(await import('/src/state/mission.ts')).showBriefing(0); return __sv.mission.getState().phase"},
  {"name": "14-telescope", "js": "(await import('/src/state/mission.ts')).closeMissions(); __sv.store.getState().setScope('hubble'); return 'ok'", "sleep": 3},
  {"name": "15-webb", "js": "__sv.store.getState().setScope('webb'); return 'ok'", "sleep": 3},
  {"name": "16-probes", "js": "__sv.store.getState().setScope(null); (await import('/src/state/probes.ts')).openProbes(); return 'ok'"},
  {"name": "17-eclipses", "js": "(await import('/src/state/probes.ts')).closeProbes(); (await import('/src/state/eclipse.ts')).openEclipses(); return 'ok'"},
  {"name": "18-log-mars", "js": "(await import('/src/state/eclipse.ts')).closeEclipses(); __sv.store.getState().setTarget('mars'); __sv.store.getState().setLogOpen(true); return 'ok'"},
  {"name": "19-log-moon", "js": "__sv.store.getState().setTarget('moon'); __sv.store.getState().setLogOpen(true); return 'ok'"},
  {"name": "20-sf-home", "js": "__sv.store.getState().setLogOpen(false); __sv.store.getState().updateSettings({ world: 'sf' }); return 'ok'", "sleep": 4},
  {"name": "21-sf-stamps", "js": "(await import('/src/state/stamps.ts')).openStamps(); return 'ok'"},
  {"name": "22-sf-chapters", "js": "(await import('/src/state/stamps.ts')).closeStamps(); (await import('/src/state/mission.ts')).openMissions(); return 'ok'"},
  {"name": "23-sf-log-colony-group", "js": "(await import('/src/state/mission.ts')).closeMissions(); __sv.store.getState().setTarget('colony-group-7'); __sv.store.getState().setLogOpen(true); return 'ok'"}
