[
 {
  "name": "e1-europa",
  "js": "__sv.store.getState().setTarget('europa'); __sv.landing.start('europa'); return __sv.landing.state.getState().phase",
  "sleep": 4
 },
 {
  "name": "e2-surface",
  "js": "__sv.landing.skip(); return __sv.landing.state.getState().phase",
  "sleep": 6
